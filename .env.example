# Robot Vision Platform Support Agent — environment variables
# Fill in your OpenRouter API key, then run:
#   set -a && source .env && set +a
#   .venv/bin/python src/evaluate.py

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional overrides
# RVP_MODEL=openai/gpt-4o-mini
# RVP_JUDGE_MODEL=anthropic/claude-3.5-sonnet
# RVP_PORT=8001

# 추천 2차 재순위(reranker) — rerank 점수로 정렬·coverage 게이트·신뢰도 산출.
# OPENROUTER_API_KEY 필요. paraphrase 평가 P@1 .898→1.0(측정).
# RVP_RERANK=1
# RVP_RERANK_MODEL=cohere/rerank-v3.5

# --- Chat engine: agno(OpenRouter, 기본) | hermes(Hermes Agent CLI) ---
# RVP_ENGINE=hermes
# 전용 hermes 프로필로 실행하려면(프로필에 agent로 등록):
#   hermes profile create lsi --clone --description "LSI 불량 분석 어시스턴트"
#   → 래퍼 ~/.local/bin/lsi 생성(= hermes -p lsi). 아래를 그 래퍼로 지정.
# HERMES_BIN=~/.local/bin/lsi      # 기본 프로필이면 ~/.local/bin/hermes
# HERMES_MODEL=          # 비우면 hermes 기본 모델 사용 (hermes model 로 확인)
# HERMES_TIMEOUT=300
# HERMES_TOOLSETS=web    # hermes 도구 활성화 (web/file/terminal/browser/..., 빈 값=비활성)

# --- Jira seeding (scripts/jira_seed.py) ---
# 공통
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
# Jira Cloud 인증 (둘 다 채우기)
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira Server/Data Center 인증 (PAT 하나만; Cloud와 택1)
JIRA_PAT=
